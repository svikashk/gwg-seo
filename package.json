{
  "name": "@getwickedgrowth/seo",
  "version": "0.1.0",
  "description": "Local website audits and search reports for people, agents, and Node.js applications.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Get Wicked Growth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svikashk/gwg-seo.git"
  },
  "bugs": {
    "url": "https://github.com/svikashk/gwg-seo/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "gwg-seo": "dist/cli.js",
    "seo": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md",
    "PRIVACY.md",
    "RELEASING.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "biome check src test scripts",
    "format": "biome check --write src test scripts",
    "check": "npm run typecheck && npm test && npm run lint && npm audit --audit-level=low",
    "prepack": "npm run build",
    "test:install": "node scripts/install-check.mjs",
    "test:registry": "node scripts/install-check.mjs --registry",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "csv-parse": "7.0.3",
    "google-auth-library": "11.3.1",
    "ipaddr.js": "2.4.0",
    "linkedom": "0.18.14",
    "robots-parser": "3.0.1",
    "saxes": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^22.20.1",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
